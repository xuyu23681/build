		phandle = <0x01>;
		reg = <0xff710000 0x8000>;
	};

	timer {
		clock-frequency = <0x16e3600>;
		compatible = "arm,armv7-timer";
		interrupts = <0x01 0x0d 0xf04 0x01 0x0e 0xf04>;
	};

	timer@ff810000 {
		compatible = "rockchip,timer";
		interrupts = <0x00 0x48 0x04>;
		reg = <0xff810000 0x20>;
		rockchip,broadcast = <0x01>;
	};

	tsadc@ff280000 {
		#io-channel-cells = <0x01>;
		clock-frequency = <0x2710>;
		clock-names = "tsadc\0pclk_tsadc";
		clocks = <0x60 0x81 0x02>;
		compatible = "rockchip,tsadc";
		interrupts = <0x00 0x25 0x04>;
		io-channel-ranges;
		pinctrl-0 = <0xf6>;
		pinctrl-1 = <0xf7>;
		pinctrl-names = "default\0tsadc_int";
		reg = <0xff280000 0x100>;
		status = "okay";
		tsadc-ht-pull-gpio = <0x00>;
		tsadc-ht-reset-cru = <0x01>;
		tsadc-ht-temp = <0x78>;
	};

	usb@ff500000 {
		clock-names = "clk_usbphy2\0hclk_usb2";
		clocks = <0x08 0x05 0x81 0x06>;
		compatible = "rockchip,rk3288_rk_ehci_host";
		interrupts = <0x00 0x18 0x04>;
		reg = <0xff500000 0x20000>;
		reset-names = "ehci_ahb\0ehci_phy\0ehci_controller\0ehci";
		resets = <0xe5 0x87 0xe5 0x88 0xe5 0x89 0xe5 0x48>;
	};

	usb@ff520000 {
		clock-names = "clk_usbphy3\0hclk_usb3";
		clocks = <0x08 0x05 0x81 0x06>;
		compatible = "rockchip,rk3288_rk_ohci_host";
		interrupts = <0x00 0x29 0x04>;
		reg = <0xff520000 0x20000>;
		status = "okay";
	};

	usb@ff540000 {
		clock-names = "clk_usbphy1\0hclk_usb1\0usbphy_480m";
		clocks = <0x08 0x06 0x81 0x07 0x30>;
		compatible = "rockchip,rk3288_usb20_host";
		interrupts = <0x00 0x19 0x04>;
		reg = <0xff540000 0x40000>;
		reset-names = "host1_ahb\0host1_phy\0host1_controller";
		resets = <0xe5 0x8a 0xe5 0x8b 0xe5 0x8c>;
	};

	usb@ff580000 {
		clock-names = "clk_usbphy0\0hclk_usb0";
		clocks = <0x08 0x04 0x81 0x04>;
		compatible = "rockchip,rk3288_usb20_otg";
		interrupts = <0x00 0x17 0x04>;
		reg = <0xff580000 0x40000>;
		reset-names = "otg_ahb\0otg_phy\0otg_controller";
		resets = <0xe5 0x84 0xe5 0x85 0xe5 0x86>;
		rockchip,usb-mode = <0x01>;
	};

	usb@ff5c0000 {
		clock-names = "ehci1phy_480m\0hclk_ehci1\0ehci1phy_12m\0usbphy_480m\0ehci1_usbphy1\0ehci1_usbphy2";
		clocks = <0x28 0x81 0x08 0xe6 0x30 0x2d 0x2e>;
		compatible = "rockchip,rk3288_rk_ehci1_host";
		interrupts = <0x00 0x1a 0x04>;
		reg = <0xff5c0000 0x40000>;
		reset-names = "ehci1_ahb\0ehci1_aux\0ehci1_phy";
		resets = <0xe5 0x49 0xe5 0x4a 0xe5 0x4b>;
	};

	usb_control {
		compatible = "rockchip,rk3288-usb-control";
		host_drv_gpio = <0x9c 0x0e 0x00>;
		otg_drv_gpio = <0x9c 0x0c 0x00>;
		rockchip,remote_wakeup;
		rockchip,usb_irq_wakeup;
	};

	vip_mmu {
		compatible = "rockchip,vip_mmu";
		dbgname = "vip";
		interrupt-names = "vip_mmu";
		interrupts = <0x00 0x0d 0x04>;
		reg = <0xff950800 0x100>;
	};

	vopb_mmu {
		compatible = "rockchip,vopb_mmu";
		dbgname = "vopb";
		interrupt-names = "vopb_mmu";
		interrupts = <0x00 0x0f 0x04>;
		reg = <0xff930300 0x100>;
	};

	vopl_mmu {
		compatible = "rockchip,vopl_mmu";
		dbgname = "vopl";
		interrupt-names = "vopl_mmu";
		interrupts = <0x00 0x10 0x04>;
		reg = <0xff940300 0x100>;
	};

	vpu_mmu {
		compatible = "rockchip,vpu_mmu";
		dbgname = "vpu";
		interrupt-names = "vpu_mmu";
		interrupts = <0x00 0x0b 0x04>;
		reg = <0xff9a0800 0x100>;
	};

	vpu_service@ff9a0000 {
		clock-names = "aclk_vcodec\0hclk_vcodec";
		clocks = <0x0c 0xe4>;
		compatible = "vpu_service";
		dev_mode = <0x00>;
		interrupt-names = "irq_enc\0irq_dec";
		interrupts = <0x00 0x09 0x04 0x00 0x0a 0x04>;
		iommu_enabled = <0x01>;
		reg = <0xff9a0000 0x800>;
		reset-names = "video_h\0video_a";
		resets = <0xe5 0x71 0xe5 0x70>;
	};

	wdt@2004c000 {
		clock-names = "pclk_wdt";
		clocks = <0x75>;
		compatible = "rockchip,watch dog";
		interrupts = <0x00 0x4f 0x04>;
		reg = <0xff800000 0x100>;
		rockchip,atboot = <0x00>;
		rockchip,debug = <0x00>;
		rockchip,irq = <0x01>;
		rockchip,timeout = <0x3c>;
		status = "okay";
	};

	wireless-bluetooth {
		BT,power_gpio = <0x04 0x1b 0x00>;
		BT,reset_gpio = <0x04 0x1d 0x00>;
		BT,wake_gpio = <0x04 0x1a 0x00>;
		BT,wake_host_irq = <0x04 0x1f 0x01>;
		compatible = "bluetooth-platdata";
		pinctrl-0 = <0x117>;
		pinctrl-1 = <0x118>;
		pinctrl-names = "default\0rts_gpio";
		status = "disabled";
		uart_rts_gpios = <0x04 0x13 0x01>;
	};

	wireless-wlan {
		compatible = "wlan-platdata";
		power_pmu_enable_level = <0x01>;
		power_pmu_regulator = "act_ldo3";
		sdio_vref = <0x708>;
		status = "okay";
		vref_pmu_enable_level = <0x01>;
		vref_pmu_regulator = "act_ldo3";
		WIFI,host_wake_irq = <0x04 0x1e 0x00>;
		WIFI,poweren_gpio = <0x04 0x1c 0x00>;
		wifi_chip_type = "ap6181";
	};
};
