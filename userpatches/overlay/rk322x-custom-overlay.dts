/dts-v1/;

/ {
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	compatible = "rockchip,rk3288";
	interrupt-parent = <0x02>;
	rockchip,sram = <0x01>;

	adc@ff100000 {
		#io-channel-cells = <0x01>;
		clock-frequency = <0xf4240>;
		clock-names = "saradc\0pclk_saradc";
		clocks = <0x61 0x81 0x01>;
		compatible = "rockchip,saradc";
		interrupts = <0x00 0x24 0x04>;
		io-channel-ranges;
		linux,phandle = <0xc3>;
		phandle = <0xc3>;
		reg = <0xff100000 0x100>;
		rockchip,adc-vref = <0x708>;
		status = "okay";

		key {
			compatible = "rockchip,key";
			io-channels = <0xc3 0x01>;

			power-key {
				gpio-key,wakeup;
				gpios = <0x9c 0x05 0x01>;
				label = "power";
				linux,code = <0x74>;
			};

			recovery-key {
				label = "recovery";
				linux,code = <0x71>;
				rockchip,adc_value = <0x04>;
			};
		};
	};

	aliases {
		i2c0 = "/i2c@ff650000";
		i2c1 = "/i2c@ff140000";
		i2c2 = "/i2c@ff660000";
